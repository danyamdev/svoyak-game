{
  "name": "own-game",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "yarn lint:code && yarn lint:styles && yarn format:check",
    "lint:fix": "yarn lint:code:fix && yarn lint:styles:fix && yarn format",
    "lint:code": "eslint . --max-warnings 0",
    "lint:code:fix": "eslint . --fix",
    "lint:styles": "stylelint \"src/**/*.scss\" --max-warnings 0",
    "lint:styles:fix": "stylelint \"src/**/*.scss\" --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "yarn lint && yarn test && yarn build",
    "preview": "vite preview"
  },
  "dependencies": {
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "3.9.10",
    "sass": "1.107.0",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "stylelint-config-standard-scss": "17.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "5.0.5"
  }
}
